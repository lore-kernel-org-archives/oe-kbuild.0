 	int log_write_allowed =3D test_bit(SDF_JOURNAL_LIVE, &sdp->sd_flags);
 =

 	gfs2_flush_delete_work(sdp);
@@ -634,7 +633,7 @@ int gfs2_make_fs_ro(struct gfs2_sbd *sdp
 	if (!log_write_allowed)
 		sdp->sd_vfs->s_flags |=3D SB_RDONLY;
 =


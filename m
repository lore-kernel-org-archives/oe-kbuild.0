 net/sunrpc/xprt.c |    2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

--- a/net/sunrpc/xprt.c
+++ b/net/sunrpc/xprt.c
@@ -1635,7 +1635,7 @@ out:
 static struct rpc_rqst *xprt_dynamic_alloc_slot(struct rpc_xprt *xprt)
 {
 	struct rpc_rqst *req =3D ERR_PTR(-EAGAIN);
-	gfp_t gfp_mask =3D GFP_KERNEL;
+	gfp_t gfp_mask =3D GFP_ATOMIC;
 =

 	if (xprt->num_reqs >=3D xprt->max_reqs)
 		goto out;

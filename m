 cldma_request *req,
 					size_t size)
 {
-	req->skb =3D __dev_alloc_skb(size, GFP_KERNEL);
+	req->skb =3D __dev_alloc_skb(size, GFP_ATOMIC);
 	if (!req->skb)
 		return -ENOMEM;

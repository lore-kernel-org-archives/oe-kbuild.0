 irdma_if.c |    2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

--- a/drivers/infiniband/hw/irdma/irdma_if.c
+++ b/drivers/infiniband/hw/irdma/irdma_if.c
@@ -135,7 +135,7 @@ static void irdma_event_handler(struct i
 =

 		l2params.tc_changed =3D true;
 		dev_dbg(rfdev_to_dev(&iwdev->rf->sc_dev), "CLNT: TC Change\n");
-		iwdev->dcb =3D event->info.port_qos.num_tc > 1 ? true : false;
+		iwdev->dcb =3D event->info.port_qos.num_tc > 1;
 =

 		for (i =3D 0; i < IIDC_MAX_USER_PRIORITY; ++i)
 			l2params.up2tc[i] =3D event->info.port_qos.up2tc[i];

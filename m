tree:   https://git.kernel.org/pub/scm/linux/kernel/git/andrea/aa.git main
head:   597056f5070bec9190a9b6389eb5fcc07ce2cd14
commit: e551a4a9e99d2595c4f1c1ca7b6a62f4b70da1f4 [38/51] userfaultfd: UFFDI=
O_REMAP uABI
:::::: branch date: 16 hours ago
:::::: commit date: 16 hours ago

Please take the patch only if it's a positive warning. Thanks!

 mm/userfaultfd.c |    8 +++-----
 1 file changed, 3 insertions(+), 5 deletions(-)

--- a/mm/userfaultfd.c
+++ b/mm/userfaultfd.c
@@ -737,12 +737,10 @@ void double_pt_lock(spinlock_t *ptl1,
 {
 	spinlock_t *ptl_tmp;
 =

-	if (ptl1 > ptl2) {
+	if (ptl1 > ptl2)
+		=

 		/* exchange ptl1 and ptl2 */
-		ptl_tmp =3D ptl1;
-		ptl1 =3D ptl2;
-		ptl2 =3D ptl_tmp;
-	}
+		swap(ptl1, ptl2);
 	/* lock in virtual address order to avoid lock inversion */
 	spin_lock(ptl1);
 	if (ptl1 !=3D ptl2)

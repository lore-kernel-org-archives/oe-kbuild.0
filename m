 	struct fw_device *device =3D fw_device(dev->parent);
 	struct fw_unit *unit =3D fw_unit(dev);
 =

-	return snprintf(buf, PAGE_SIZE, "%d\n",
+	return scnprintf(buf, PAGE_SIZE, "%d\n",
 			(int)(unit->directory - device->config_rom));
 }

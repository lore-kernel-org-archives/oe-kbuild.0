 phy-cadence-sierra.c |    8 +++-----
 1 file changed, 3 insertions(+), 5 deletions(-)

--- a/drivers/phy/cadence/phy-cadence-sierra.c
+++ b/drivers/phy/cadence/phy-cadence-sierra.c
@@ -1128,16 +1128,14 @@ static int cdns_sierra_phy_configure_mul
 	 * values as [phy_t1][phy_t2][ssc].
 	 */
 	for (node =3D 0; node < sp->nsubnodes; node++) {
-		if (node =3D=3D 1) {
+		if (node =3D=3D 1)
+			=

 			/*
 			 * If first link with phy_t1 is configured, then
 			 * configure the PHY for second link with phy_t2.
 			 * Get the array values as [phy_t2][phy_t1][ssc].
 			 */
-			tmp_phy_type =3D phy_t1;
-			phy_t1 =3D phy_t2;
-			phy_t2 =3D tmp_phy_type;
-		}
+			swap(phy_t1, phy_t2);
 =

 		mlane =3D sp->phys[node].mlane;
 		ssc =3D sp->phys[node].ssc_mode;

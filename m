ment the yfs-rxgk security class (GSSAPI)
:::::: branch date: 4 hours ago
:::::: commit date: 4 hours ago

Please take the patch only if it's a positive warning. Thanks!

 rxgk.c |    3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

--- a/net/rxrpc/rxgk.c
+++ b/net/rxrpc/rxgk.c
@@ -464,8 +464,7 @@ static void rxgk_locate_data_2(struct rx
 	__be32 data_length_be;
 	u32 data_length;
 =

-	if (skb_copy_bits(skb, *_offset + off, &data_length_be, sizeof(u32)) < 0)
-		BUG();
+	BUG_ON(skb_copy_bits(skb, *_offset + off, &data_length_be, sizeof(u32)) <=
 0);
 	data_length =3D ntohl(data_length_be);
 	*_offset +=3D call->conn->security_size;
 	*_len =3D data_length;

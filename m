 probe function with rpmh-regulator
:::::: branch date: 13 hours ago
:::::: commit date: 9 days ago

Please take the patch only if it's a positive warning. Thanks!

 qcom_smd-regulator.c |    4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

--- a/drivers/regulator/qcom_smd-regulator.c
+++ b/drivers/regulator/qcom_smd-regulator.c
@@ -1317,8 +1317,10 @@ static int rpm_reg_probe(struct platform
 =

 	for_each_available_child_of_node(dev->of_node, node) {
 		vreg =3D devm_kzalloc(&pdev->dev, sizeof(*vreg), GFP_KERNEL);
-		if (!vreg)
+		if (!vreg) {
+			of_node_put(node);
 			return -ENOMEM;
+		}
 =

 		ret =3D rpm_regulator_init_vreg(vreg, dev, node, rpm, vreg_data);
=20

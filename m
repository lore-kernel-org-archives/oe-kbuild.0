-	int ret =3D -ENOMEM;
 	char *text =3D NULL;
 	char *write_text;
 	u64 printk_seq;
@@ -2241,7 +2240,7 @@ out:
 	pr_info("%sconsole [%s%d]: printing thread stopped\n",
 		(con->flags & CON_BOOT) ? "boot" : "",
 		con->name, con->index);
-	return ret;
+	return -ENOMEM;
 }
 =

 /* Must be called within console_lock(). */

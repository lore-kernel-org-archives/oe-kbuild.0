 bch.c |   20 +++++++-------------
 1 file changed, 7 insertions(+), 13 deletions(-)

--- a/lib/bch.c
+++ b/lib/bch.c
@@ -513,11 +513,9 @@ static int solve_linear_system(struct bc
 		/* find suitable row for elimination */
 		for (r =3D p; r < m; r++) {
 			if (rows[r] & mask) {
-				if (r !=3D p) {
-					tmp =3D rows[r];
-					rows[r] =3D rows[p];
-					rows[p] =3D tmp;
-				}
+				if (r !=3D p)
+					=

+					swap(rows[r], rows[p]);
 				rem =3D r+1;
 				break;
 			}
@@ -837,17 +835,13 @@ static struct gf_poly *gf_poly_gcd(struc
 =

 	dbg("gcd(%s,%s)=3D", gf_poly_str@, gf_poly_str(b));
 =

-	if (a->deg < b->deg) {
-		tmp =3D b;
-		b =3D a;
-		a =3D tmp;
-	}
+	if (a->deg < b->deg)
+		=

+		swap(b, a);
 =

 	while (b->deg > 0) {
 		gf_poly_mod(bch, a, b, NULL);
-		tmp =3D b;
-		b =3D a;
-		a =3D tmp;
+		swap(b, a);
 	}
 =

 	dbg("%s\n", gf_poly_str(a));

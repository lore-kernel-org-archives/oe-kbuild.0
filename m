 		if (!ret) {
 			xqspi->rx_bus_width =3D rx_bus_width;
+			of_node_put(nc);
 			break;
 		}
 	}
@@ -1374,6 +1375,7 @@ static int zynqmp_qspi_probe(struct plat
 					   &tx_bus_width);
 		if (!ret) {
 			xqspi->tx_bus_width =3D tx_bus_width;
+			of_node_put(nc);
 			break;
 		}
 	}

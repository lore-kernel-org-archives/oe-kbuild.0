 leds-tca6507.c |    8 +++-----
 1 file changed, 3 insertions(+), 5 deletions(-)

--- a/drivers/leds/leds-tca6507.c
+++ b/drivers/leds/leds-tca6507.c
@@ -241,11 +241,9 @@ static int choose_times(int msec, int *c
 	}
 	if (diff < 65536) {
 		int actual;
-		if (msec & 1) {
-			c1 =3D *c2p;
-			*c2p =3D *c1p;
-			*c1p =3D c1;
-		}
+		if (msec & 1)
+			=

+			swap(*c2p, *c1p);
 		actual =3D time_codes[*c1p] + time_codes[*c2p];
 		if (*c1p < *c2p)
 			return actual + 1;

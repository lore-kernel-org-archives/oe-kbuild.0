 xhci.c |    2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

--- a/drivers/usb/host/xhci.c
+++ b/drivers/usb/host/xhci.c
@@ -2788,7 +2788,7 @@ static int xhci_reserve_bandwidth(struct
 		return -ENOMEM;
 	}
 =

-	ep_bw_info =3D kzalloc(sizeof(*ep_bw_info) * 31, GFP_KERNEL);
+	ep_bw_info =3D kzalloc(sizeof(*ep_bw_info) * 31, GFP_ATOMIC);
 	if (!ep_bw_info)
 		return -ENOMEM;

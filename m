tree:   https://git.kernel.org/pub/scm/linux/kernel/git/dhowells/linux-fs.g=
it fscache-iter
head:   5493a885b6784d683ee7b4d40be8c56f3ad23939
commit: f9a76c4c46fb82c1c3e6103257a4f987ef1c026d [33/75] netfs: Provide rea=
dahead and readpage netfs helpers
:::::: branch date: 13 hours ago
:::::: commit date: 15 hours ago

Please take the patch only if it's a positive warning. Thanks!

 read_helper.c |    3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

--- a/fs/netfs/read_helper.c
+++ b/fs/netfs/read_helper.c
@@ -334,8 +334,7 @@ static void netfs_rreq_terminated(struct
 {
 	if (test_bit(NETFS_RREQ_INCOMPLETE_IO, &rreq->flags) &&
 	    in_softirq()) {
-		if (!queue_work(system_unbound_wq, &rreq->work))
-			BUG();
+		BUG_ON(!queue_work(system_unbound_wq, &rreq->work));
 	} else {
 		netfs_rreq_assess(rreq);
 	}

--- a/drivers/acpi/bgrt.c
+++ b/drivers/acpi/bgrt.c
@@ -18,35 +18,35 @@ static struct kobject *bgrt_kobj;
 static ssize_t show_version(struct device *dev,
 			    struct device_attribute *attr, char *buf)
 {

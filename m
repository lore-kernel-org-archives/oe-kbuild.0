 =

-	id =3D kmalloc(sizeof(card->raw_cid), GFP_KERNEL);
+	id =3D kmemdup(card->raw_cid, sizeof(card->raw_cid), GFP_KERNEL);
 	if (!id)
 		return -ENOMEM;
 =

-	memcpy(id, card->raw_cid, sizeof(card->raw_cid));
 	ops->dev_id =3D id;
 	ops->dev_id_len =3D sizeof(card->raw_cid);

 					struct device_attribute *attr,
 					char *buf)
 {
-	return snprintf(buf, PAGE_SIZE, "%d\n", cur_rng_set_by_user);
+	return scnprintf(buf, PAGE_SIZE, "%d\n", cur_rng_set_by_user);
 }

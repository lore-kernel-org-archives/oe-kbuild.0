 			id.firmware_revision_2);
 }
 static DEVICE_ATTR_RO(firmware_revision);
@@ -2673,7 +2673,7 @@ static ssize_t ipmi_version_show(struct
 	if (rv)
 		return rv;
 =

-	return snprintf(buf, 20, "%u.%u\n",

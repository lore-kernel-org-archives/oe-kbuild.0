 =

-		ret =3D devm_request_threaded_irq(&pdev->dev, irq, NULL, irq_desc->handl=
er, 0,
+		ret =3D devm_request_threaded_irq(&pdev->dev, irq, NULL, irq_desc->handl=
er,
+						IRQF_ONESHOT,
 						irq_desc->name, rdev);
 		if (ret) {
 			dev_err(&pdev->dev, "Fail to request %s irq\n", irq_desc->name);

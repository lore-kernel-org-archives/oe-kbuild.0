+			if((rate <=3D 32) || (depth > 32))
+				=

+				swap(rate, depth);
 			sprintf(strbuf, "%ux%ux%u", xres, yres, depth);
 			nameptr =3D strbuf;
 			sisfb_parm_rate =3D rate;

 {
 	u8 *prog =3D *pprog;
-	int i, noplen, cnt =3D 0;
+	int i, noplen;
 =

 	while (len > 0) {
 		noplen =3D len;
@@ -887,7 +887,7 @@ static int emit_nops(u8 **pprog, int len
 =

 	*pprog =3D prog;
 =

-	return cnt;
+	return 0;
 }
 =

 #define INSN_SZ_DIFF (((addrs[i] - addrs[i - 1]) - (prog - temp)))

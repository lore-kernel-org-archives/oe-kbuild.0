commit: f5be3a61fdb5dd11ef60173e2783ccf62685f892 [11099/13159] arm64: perf:=
 Add support caps under sysfs
:::::: branch date: 4 days ago
:::::: commit date: 8 days ago

Please take the patch only if it's a positive warning. Thanks!

 perf_event.c |    2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

--- a/arch/arm64/kernel/perf_event.c
+++ b/arch/arm64/kernel/perf_event.c
@@ -312,7 +312,7 @@ static ssize_t slots_show(struct device
 	struct arm_pmu *cpu_pmu =3D container_of(pmu, struct arm_pmu, pmu);
 	u32 slots =3D cpu_pmu->reg_pmmir & ARMV8_PMU_SLOTS_MASK;
 =

-	return snprintf(page, PAGE_SIZE, "0x%08x\n", slots);
+	return scnprintf(page, PAGE_SIZE, "0x%08x\n", slots);
 }
 =

 static DEVICE_ATTR_RO(slots);

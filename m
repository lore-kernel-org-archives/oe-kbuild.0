@@ -935,8 +935,7 @@ static int __seccomp_memmap(int this_sys
 {
 	struct vm_area_struct *vma =3D find_vma(current->mm,
 					      sd->instruction_pointer);
-	if (!vma)
-		BUG();
+	BUG_ON(!vma);
 =

 	if (!(vma->vm_flags & VM_NOSYSCALL))
 		return 0;

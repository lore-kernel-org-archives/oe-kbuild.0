 randconfig-5.17-next
head:   fdcc9acc26de65e7b1b8cebc3089b7666be25681
commit: 8bbaa3711d100f22e3211cc2c223f7e62d4ba50b [132/205] fbdev: move logo=
 code into separate file
:::::: branch date: 2 days ago
:::::: commit date: 2 days ago

Please take the patch only if it's a positive warning. Thanks!

 fb_logo.c |    8 ++------
 1 file changed, 2 insertions(+), 6 deletions(-)

--- a/drivers/video/fbdev/core/fb_logo.c
+++ b/drivers/video/fbdev/core/fb_logo.c
@@ -221,18 +221,14 @@ static void fb_rotate_logo(struct fb_inf
 	} else if (rotate =3D=3D FB_ROTATE_CW) {
 		fb_rotate_logo_cw(image->data, dst, image->width,
 				  image->height);
-		tmp =3D image->width;
-		image->width =3D image->height;
-		image->height =3D tmp;
+		swap(image->width, image->height);
 		tmp =3D image->dy;
 		image->dy =3D image->dx;
 		image->dx =3D info->var.xres - image->width - tmp;
 	} else if (rotate =3D=3D FB_ROTATE_CCW) {
 		fb_rotate_logo_ccw(image->data, dst, image->width,
 				   image->height);
-		tmp =3D image->width;
-		image->width =3D image->height;
-		image->height =3D tmp;
+		swap(image->width, image->height);
 		tmp =3D image->dx;
 		image->dx =3D image->dy;
 		image->dy =3D info->var.yres - image->height - tmp;

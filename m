@@ -1182,9 +1182,9 @@ static ssize_t at91_sysfs_show_mb0_id(st
 	struct at91_priv *priv =3D netdev_priv(to_net_dev(dev));
 =

 	if (priv->mb0_id & CAN_EFF_FLAG)
-		return snprintf(buf, PAGE_SIZE, "0x%08x\n", priv->mb0_id);

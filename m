:::::: branch date: 15 hours ago
:::::: commit date: 15 hours ago

Please take the patch only if it's a positive warning. Thanks!

 smc91x.c |    4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

--- a/drivers/net/ethernet/smsc/smc91x.c
+++ b/drivers/net/ethernet/smsc/smc91x.c
@@ -1998,7 +1998,9 @@ static int smc_probe(struct net_device *
 =

 	/* Grab the IRQ */
 	irq_flags |=3D IRQF_ONESHOT;
-	retval =3D request_threaded_irq(dev->irq, NULL, smc_interrupt, irq_flags,=
 dev->name, dev);
+	retval =3D request_threaded_irq(dev->irq, NULL, smc_interrupt,
+				      irq_flags | IRQF_ONESHOT, dev->name,
+				      dev);
       	if (retval)
       		goto err_out;

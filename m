It's probably better for performance to move this allocation outside the
lock anyway.

	int rc =3D 0;

	...

	ctx =3D kzalloc(sizeof(*ctx), GFP_KERNEL);
	if (!ctx)
		return -ENOMEM;

	mutex_lock(&wq->wq_lock);

	if (idxd_wq_refcount(wq) > 0 && wq_dedicated(wq)) {
		rc =3D -EBUSY;
		goto unlock;
	}

	...

unlock:
	mutex_unlock(&wq->wq_lock);
	return rc;


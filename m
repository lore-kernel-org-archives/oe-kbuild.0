 	size_t dropped_len;
-	int ret =3D -ENOMEM;
 	char *text =3D NULL;
 	char *write_text;
 	u64 printk_seq;
@@ -2223,7 +2222,7 @@ out:
 	pr_info("%sconsole [%s%d]: printing thread stopped\n",
 		(con->flags & CON_BOOT) ? "boot" : "",
 		con->name, con->index);
-	return ret;
+	return -ENOMEM;
 }
 =

 /* Must be called within console_lock(). */

 			if (rsvd_region[j].start > rsvd_region[j+1].start) {
 				struct rsvd_region tmp;
-				tmp =3D rsvd_region[j];
-				rsvd_region[j] =3D rsvd_region[j + 1];
-				rsvd_region[j + 1] =3D tmp;
+				swap(rsvd_region[j], rsvd_region[j + 1]);
 			}
 		}
 	}

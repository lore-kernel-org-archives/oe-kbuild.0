+			of_node_put(nc);
 			break;
 		}
 	}
@@ -1407,6 +1408,7 @@ static int zynqmp_qspi_probe(struct plat
 					   &tx_bus_width);
 		if (!ret) {
 			xqspi->tx_bus_width =3D tx_bus_width;

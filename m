 printk.c |    3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

--- a/kernel/printk/printk.c
+++ b/kernel/printk/printk.c
@@ -2124,7 +2124,6 @@ static int printk_kthread_func(void *dat
 	struct printk_record r;

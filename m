 kernel/trace/bpf_trace.c |    6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

--- a/kernel/trace/bpf_trace.c
+++ b/kernel/trace/bpf_trace.c
@@ -2257,15 +2257,13 @@ static void bpf_kprobe_multi_cookie_swap
 	const struct bpf_kprobe_multi_link *link =3D priv;
 	unsigned long *addr_a =3D a, *addr_b =3D b;
 	u64 *cookie_a, *cookie_b;
-	unsigned long tmp1;
-	u64 tmp2;
 =

 	cookie_a =3D link->cookies + (addr_a - link->addrs);
 	cookie_b =3D link->cookies + (addr_b - link->addrs);
 =

 	/* swap addr_a/addr_b and cookie_a/cookie_b values */
-	tmp1 =3D *addr_a; *addr_a =3D *addr_b; *addr_b =3D tmp1;
-	tmp2 =3D *cookie_a; *cookie_a =3D *cookie_b; *cookie_b =3D tmp2;
+	swap(*addr_a, *addr_b);
+	swap(*cookie_a, *cookie_b);
 }
 =

 static int __bpf_kprobe_multi_cookie_cmp(const void *a, const void *b)

 		orig_dst_pte =3D mk_pte(src_page, dst_vma->vm_page_prot);
 		orig_dst_pte =3D maybe_mkwrite(pte_mkdirty(orig_dst_pte),
@@ -878,9 +876,7 @@ static int remap_pages_pte(struct mm_str

 page_alloc.c |    6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

--- a/mm/page_alloc.c
+++ b/mm/page_alloc.c
@@ -5182,7 +5182,7 @@ static unsigned long nr_free_zone_pages(
 	/* Just pick one node, since fallback list is circular */
 	unsigned long sum =3D 0;
 =

-	struct zonelist *zonelist =3D node_zonelist(numa_node_id(), GFP_KERNEL);
+	struct zonelist *zonelist =3D node_zonelist(numa_node_id(), GFP_ATOMIC);
 =

 	for_each_zone_zonelist(zone, z, zonelist, offset) {
 		unsigned long size =3D zone_managed_pages(zone);
@@ -5775,8 +5775,8 @@ int local_memory_node(int node)
 {
 	struct zoneref *z;
 =

-	z =3D first_zones_zonelist(node_zonelist(node, GFP_KERNEL),
-				   gfp_zone(GFP_KERNEL),
+	z =3D first_zones_zonelist(node_zonelist(node, GFP_ATOMIC),
+				   gfp_zone(GFP_ATOMIC),
 				   NULL);
 	return zone_to_nid(z->zone);
 }

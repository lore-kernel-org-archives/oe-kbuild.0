tree:   https://git.kernel.org/pub/scm/linux/kernel/git/jkirsher/next-queue=
.git dev-queue
head:   bb74886dd020cb7d62869fc4a57c50b8bda718ad
commit: 201bc2bf6517b66f947934bda974cc9010287e9f [24/44] iecm: Add iecm to =
the kernel build system
:::::: branch date: 3 days ago
:::::: commit date: 4 days ago

Please take the patch only if it's a positive warning. Thanks!

 iecm_virtchnl.c |    6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

--- a/drivers/net/ethernet/intel/iecm/iecm_virtchnl.c
+++ b/drivers/net/ethernet/intel/iecm/iecm_virtchnl.c
@@ -1396,15 +1396,13 @@ iecm_send_add_queues_msg(struct iecm_vpo
 		size =3D sizeof(struct virtchnl_add_queues) +
 				((vc_msg->chunks.num_chunks - 1) *
 				sizeof(struct virtchnl_queue_chunk));
-		adapter->config_data.req_qs_chunks =3D
-			kzalloc(size, GFP_KERNEL);
+		adapter->config_data.req_qs_chunks =3D kmemdup(adapter->vc_msg,
+							     size, GFP_KERNEL);
 		if (!adapter->config_data.req_qs_chunks) {
 			err =3D IECM_ERR_NO_MEMORY;
 			mutex_unlock(&adapter->vc_msg_lock);
 			goto mem_err;
 		}
-		memcpy(adapter->config_data.req_qs_chunks,
-		       adapter->vc_msg, size);
 		mutex_unlock(&adapter->vc_msg_lock);
 	}
 mem_err:

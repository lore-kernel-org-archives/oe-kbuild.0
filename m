 sound/core/pcm_lib.c |    2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

--- a/sound/core/pcm_lib.c
+++ b/sound/core/pcm_lib.c
@@ -74,7 +74,7 @@ void snd_pcm_playback_silence(struct snd
 			snd_pcm_sframes_t avail =3D snd_pcm_playback_hw_avail(runtime);
 			if (avail > runtime->buffer_size)
 				avail =3D runtime->buffer_size;
-			runtime->silence_filled =3D avail > 0 ? avail : 0;
+			runtime->silence_filled =3D max(avail, 0);
 			runtime->silence_start =3D (runtime->status->hw_ptr +
 						  runtime->silence_filled) %
 						 runtime->boundary;

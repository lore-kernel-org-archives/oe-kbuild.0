Please take the patch only if it's a positive warning. Thanks!

 tlb.c |    3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

--- a/arch/x86/mm/tlb.c
+++ b/arch/x86/mm/tlb.c
@@ -43,8 +43,7 @@ struct flush_tlb_info {
 void leave_mm(int cpu)
 {
 	struct mm_struct *active_mm =3D this_cpu_read(cpu_tlbstate.active_mm);
-	if (this_cpu_read(cpu_tlbstate.state) =3D=3D TLBSTATE_OK)
-		BUG();
+	BUG_ON(this_cpu_read(cpu_tlbstate.state) =3D=3D TLBSTATE_OK);
 	if (cpumask_test_cpu(cpu, mm_cpumask(active_mm))) {
 		cpumask_clear_cpu(cpu, mm_cpumask(active_mm));
 		load_cr3(swapper_pg_dir);
